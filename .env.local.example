# Copia este archivo como .env.local y rellénalo.
# Todo esto lo usa solo el servidor: nunca se envía al navegador ni se muestra en pantalla.

# Clave de OpenRouter para la IA
OPENROUTER_API_KEY=

# Opcional. Modelo de texto y de audio (por defecto, Gemini 3 Flash, que también entiende audio).
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# OPENROUTER_AUDIO_MODEL=google/gemini-3-flash-preview

# Base de datos (Supabase → Project Settings → API): URL del proyecto y clave publicable (sb_publishable_…).
# No uses aquí la clave secreta (service_role): la app no la necesita.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Contraseña de la cuenta asistente@taller.invalid, con la que la app atiende el chat público.
SUPABASE_ASISTENTE_CLAVE=
